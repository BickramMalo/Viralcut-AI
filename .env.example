# ViralCut AI – Root Environment Variables
# Copy to .env and edit before running docker compose up

# ── OpenAI ────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# ── Application ───────────────────────────────────────────
APP_NAME=ViralCut AI
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Whisper ───────────────────────────────────────────────
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=float16

# ── Storage ───────────────────────────────────────────────
STORAGE_PATH=./storage
STORAGE_BACKEND=local

# ── S3 (optional – set STORAGE_BACKEND=s3 to use) ───────
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=viralcut-storage
S3_REGION=us-east-1

# ── CORS ──────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ── Video Processing ─────────────────────────────────────
MAX_VIDEO_DURATION_MINUTES=120
MAX_UPLOAD_SIZE_MB=2048
DEFAULT_CLIP_MIN_DURATION=15
DEFAULT_CLIP_MAX_DURATION=90
DEFAULT_ASPECT_RATIO=9:16
